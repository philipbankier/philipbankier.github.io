{
  "name": "philip-bankier-site",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run build:gh",
    "preview": "vite preview --host",
    "check": "scripts/check",
    "format": "prettier --write .",
    "build:gh": "scripts/check && scripts/test && scripts/build && scripts/verify",
    "test": "scripts/test",
    "build:review": "scripts/check && scripts/test && scripts/build --review && scripts/verify",
    "writing:refresh": "tsx --tsconfig tsconfig.scripts.json scripts/refresh-writing.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "0.9.12",
    "parse5": "8.0.1",
    "prettier": "^3.6.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "zod": "4.6.5"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
